# DrishtiXAI Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./drishtixai.db
# For production PostgreSQL: postgresql://drishti_user:drishti_pass@localhost:5432/drishtixai_db

# Model Configurations & Thresholds
CLASSIFIER_VERSION=dr_classifier_v0.1.0
LESION_VERSION=lesion_unet_v0.1.0
CALIBRATION_VERSION=calib_v0.1.0

# Clinical & Threshold Settings
REFERRAL_THRESHOLD=0.50
QUALITY_PASS_THRESHOLD=75.0
QUALITY_BORDERLINE_THRESHOLD=50.0

# Output Paths
OUTPUT_DIR=backend/outputs
WEIGHTS_DIR=backend/weights
